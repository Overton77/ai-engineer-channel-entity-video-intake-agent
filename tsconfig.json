{
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["agent/**/*.ts", "apify-transcript-ingest/**/*.mts", "contracts/**/*.ts", "controller/**/*.ts", "executor/**/*.ts", "evals/**/*.ts", "lib/**/*.ts", "tests/**/*.mts"]
}
