# Copy to .env. Do not commit secrets.
# Use the same Supabase project as research_starter_videos.

AI_GATEWAY_API_KEY=

POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Do not set EXA_API_KEY. Eve web_search uses Exa through AI Gateway.

# Optional. Every transcript is iteratively summarized in bounded sections.
# Default 12000; minimum 2000.
PRE_RESEARCH_TRANSCRIPT_CHUNK_CHARACTERS=12000

# Optional local disk safety floor in GiB. Default 1.5; minimum 0.5.
PRE_RESEARCH_MIN_FREE_GB=1.5

# Production scheduler controls. Keep disabled in an ordinary local .env.
# Vercel Production currently enables the schedule separately.
PRE_RESEARCH_SCHEDULE_ENABLED=false
# A parked run cools down while another video receives the next serial Cron tick.
# Default 10 whole minutes; allowed range 5-60.
PRE_RESEARCH_SCHEDULE_RETRY_COOLDOWN_MINUTES=10
# Absolute Cron controller budget; default 240000 ms, range 60000-270000.
# Keep this below Vercel's 300-second function limit so cleanup can unlock.
PRE_RESEARCH_SCHEDULE_INVOCATION_BUDGET_MS=240000
# Per-invocation wait for a durable Eve stage; default 120000 ms, range 15000-240000.
PRE_RESEARCH_CONTROLLER_STAGE_WAIT_MS=120000

# Apify transcript ingest (apify-transcript-ingest/). Token stays local; never commit it.
APIFY_API_KEY=
APIFY_USER_ID=
# Optional. Defaults to starvibe/youtube-video-transcript.
APIFY_TRANSCRIPT_ACTOR_ID=starvibe/youtube-video-transcript

# Local built-server only. Set in the Eve start process, never in Vercel.
PRE_RESEARCH_LOCAL_EVE_START=false
# For local built-server batch runs, set PORT=2000 in the process environment.

# Optional local-only (put in .env.local, not here): EVE_TRACES=off
# turns off the .eve/traces spool (default budget 512 MB).
