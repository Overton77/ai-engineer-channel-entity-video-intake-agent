{
  "name": "research_starter_pre_research_agent",
  "version": "0.0.0",
  "type": "module",
  "imports": {
    "#*": "./agent/*",
    "#evals/*": "./evals/*"
  },
  "scripts": {
    "build": "eve build",
    "dev": "eve dev",
    "start": "eve start",
    "typecheck": "tsc",
    "test": "node --experimental-strip-types --import ./scripts/register-ts.mjs --test tests/**/*.test.mts",
    "list:eligible": "node scripts/list-eligible-videos.mjs",
    "run:next": "node scripts/run-pre-research-session.mjs --next",
    "run:all": "node scripts/run-pre-research-session.mjs --all",
    "pipeline:next": "node --experimental-strip-types --import ./scripts/register-ts.mjs scripts/run-pre-research-pipeline.mjs --next",
    "pipeline:all": "node --experimental-strip-types --import ./scripts/register-ts.mjs scripts/run-all-pre-research-pipelines.mjs",
    "maintenance:prune-eve-runtime": "node scripts/prune-eve-stream-cache.mjs",
    "apply:intent": "node --experimental-strip-types --import ./scripts/register-ts.mjs scripts/apply-pre-research-intent.mts",
    "query:pre-research": "node --experimental-strip-types --import ./scripts/register-ts.mjs scripts/query-pre-research.mts",
    "readable:summaries": "node scripts/readable-summaries.mjs"
  },
  "dependencies": {
    "@vercel/connect": "0.4.3",
    "ai": "^7.0.58",
    "eve": "^0.38.3",
    "pg": "^8.23.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.x",
    "@types/pg": "^8.21.0",
    "typescript": "7.0.2"
  },
  "overrides": {
    "ai": "^7.0.58"
  },
  "engines": {
    "node": "24.x"
  }
}
